# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/
.env
.env.*

# Local-only config (credentials, personal overrides) -- never commit
config/local.yaml
config/local.*.yaml
**/secrets.*

# Data outputs
data/
*.fits
*.parquet
*.csv
*.jsonl

# Tool caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Local/editor files
.DS_Store
*.log

# Claude Code local config and memory
.claude/

# Codex desktop local task metadata; keep the portable project MCP config.
.codex/*
!.codex/config.toml

# Large astronomical data formats
*.hdf5
*.h5

# Archives generated for sharing
*.zip
*.tar
*.tar.gz
